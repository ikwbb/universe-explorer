{
  "name": "universe-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive 3D journey from Earth to the Local Group, with offline JPL spacecraft ephemerides.",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "data:download": "node scripts/fetch-ephemeris.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "@react-three/drei": "^10.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "tsx": "^4.20.0"
  }
}
